NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret
APP_URL=http://localhost:3000
# Optional for local database integration tests only
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server-only screenshot cleanup authorization (Vercel daily backup and Supabase Cron every minute)
CRON_SECRET=

# Optional browser push; generate a VAPID key pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Server-only bearer credential used by Supabase Cron to invoke the notification route.
NOTIFICATION_WORKER_SECRET=
